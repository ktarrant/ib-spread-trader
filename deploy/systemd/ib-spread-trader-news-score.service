# Scores the day's new headlines with Codex, on the capture server, right after
# ib-option-calc's daily headline sync succeeds (the drop-in beside this file).
# Spread over the week this way, ~10 calls a day never fills a Codex usage
# window; --limit caps a day's backlog (the first days, 600 calls since August).
#
# Install, as the capture user:
#   scripts/news_score.py, news_profile.py, option_premium.py, news_schema.json
#     -> ~/ib-spread-trader/scripts/
#   codex on PATH (below), then `codex login --device-auth` once
#   cp ib-spread-trader-news-score.service ~/.config/systemd/user/
#   cp -r ib-option-calc-news.service.d ~/.config/systemd/user/
#   systemctl --user daemon-reload
# Check: systemctl --user start ib-spread-trader-news-score.service, then
#   journalctl --user -u ib-spread-trader-news-score
# Fetch the cache to the laptop: scripts/fetch_news_cache.sh

[Unit]
Description=ib-spread-trader: score new headlines with Codex

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# The live capture DB, opened read-only (news_score.py never writes to it).
ExecStart=/usr/bin/python3 %h/ib-spread-trader/scripts/news_score.py \
    --db %h/.local/share/ib-option-calc/ib-option-calc.sqlite3 \
    --cache %h/news-llm.sqlite3 --since 2026-08-01 --limit 150 --jobs 2
# 2 is a usage-limit stop: tomorrow's run resumes where it left off.
SuccessExitStatus=2
